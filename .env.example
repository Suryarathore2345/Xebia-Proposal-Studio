# LLM API Key (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini keys - only used by the Claude/Gemini testing toggle in the chat UI.
# Add as many GEMINI_API_KEY_N as you have; each is tried in order only
# after the previous one hits a rate limit/quota error. GEMINI_API_KEY_1
# may also be set as a bare GEMINI_API_KEY.
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Stock photo API (Pexels) - optional, enables photos on content slides
PEXELS_API_KEY=your_pexels_api_key_here

# Database (uncomment when PostgreSQL is installed)
# DATABASE_URL=postgresql://xebia_studio:your_password@localhost:5432/xebia_proposal_studio

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Paths
REFERENCE_DIR=./references
EXTRACTED_DIR=./extracted
OUTPUT_DIR=./outputs
